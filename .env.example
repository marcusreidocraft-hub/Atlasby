# Preencha estes valores só no ambiente do host. Não commite segredos.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
ALLOWED_GUILD_IDS=

# Opcional. Vazio usa o padrão: diretório data e confirmação de 60 segundos.
DATA_DIR=
# Segredo igual em todas as VMs. Vazio desliga a liberação do PIN. Não commite o valor.
AGENT_SECRET=
# Porta do agente dentro da VM. Vazio usa 7474.
AGENT_PORT=7474
# Porta do webhook Pix. O Bot-Hosting preenche SERVER_PORT. Vazio desliga o webhook.
SERVER_PORT=
# Chave e segredo da Wyvi. Vazios desligam a cobrança. Não commite valores.
WYVI_API_KEY=
WYVI_WEBHOOK_SECRET=
WYVI_API_BASE=https://api.wyvipay.com.br
CONFIRMATION_TTL_SECONDS=
ENABLE_MESSAGE_CONTENT_INTENT=

# Opcional. Sem estes valores o bot sobe e as ações de energia só avisam a equipe.
# Não commite segredos.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
# Opcional. Cifra senha RDP e PIN. Se vazio, CREDENTIALS_KEY é usada. Se as duas faltarem, senha e PIN não são gravados.
AZURE_CREDENTIALS_KEY=
CREDENTIALS_KEY=

# Imagem da galeria. Vazio usa Atlas2.0 versão 1.0.0. A definição sem /versions também vale e pega a última.
AZURE_IMAGE_ID=
# Legado. Só entra se /configurar-imagem escolher snapshot. A imagem tem prioridade.
AZURE_SNAPSHOT_ID=
AZURE_LOCATION=brazilsouth
AZURE_DEFAULT_VM_SIZE=Standard_NC4as_T4_v3
AZURE_OS_TYPE=Windows
# Exemplos: vnet-brazilsouth-4 e snet-brazilsouth-1. Vazios até serem preenchidos no host.
AZURE_VIRTUAL_NETWORK=
AZURE_SUBNET=
AZURE_MAX_OS_DISK_GB=2048

# Cor de destaque dos painéis Components V2. Hex com ou sem #.
PANEL_COLOR=5865F2
# Opcional. URL https de uma imagem do painel. Vazio não mostra galeria nem miniatura.
PANEL_BANNER_URL=

# Link do botão Suporte / Tickets. Também pode ser definido por /configurar suporte.
SUPPORT_CHANNEL_URL=
# Cargos que administram o painel, além de quem tem a permissão Administrador. IDs separados por vírgula.
ADMIN_ROLE_IDS=
# Canal que recebe o log das ações. Também pode ser definido por /configurar logs.
ADMIN_LOG_CHANNEL_ID=

# Opcional. Vazio usa o emoji padrão já embutido no código.
# Se esse emoji não estiver no cache do bot, o botão cai para o Unicode.
EMOJI_CONTROLE=
EMOJI_CALENDARIO=
EMOJI_TICKET=
EMOJI_MOONLIGHT=
EMOJI_RDP=
EMOJI_ALERTA=
EMOJI_ENGRENAGEM=
EMOJI_POWER=
EMOJI_LIGADA=
EMOJI_DESLIGAR=

# Reservado. Com false, o bot não chama o Ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_API_KEY=
AI_ASSISTANT_ENABLED=false
