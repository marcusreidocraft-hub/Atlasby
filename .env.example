# Preencha estes valores só no ambiente do host. Não commite segredos.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
ALLOWED_GUILD_IDS=

# Opcional. Vazio usa o padrão: diretório data e confirmação de 60 segundos.
# Canal de logs, planos, preços, estoque, categoria e cargo não ficam aqui.
DATA_DIR=
CONFIRMATION_TTL_SECONDS=
ENABLE_MESSAGE_CONTENT_INTENT=

# Opcional. Sem estes valores o bot sobe e o menu avisa que a Azure não está configurada.
# Não commite segredos. O restante das VMs é cadastrado pelo Discord.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
# Opcional. Se vazio, a senha das VMs é cifrada com o segredo do service principal.
AZURE_CREDENTIALS_KEY=

# ID de recurso completo de um snapshot. Pode estar em outra assinatura. Vazio não cria VM.
AZURE_SNAPSHOT_ID=
AZURE_LOCATION=brazilsouth
AZURE_DEFAULT_VM_SIZE=Standard_NC4as_T4_v3
AZURE_OS_TYPE=Windows
# Exemplos: vnet-brazilsouth-4 e snet-brazilsouth-1. Vazios até serem preenchidos no host.
AZURE_VIRTUAL_NETWORK=
AZURE_SUBNET=
AZURE_MAX_OS_DISK_GB=2048

# Cor de destaque dos painéis Components V2 quando /configurar não define uma cor. Hex com ou sem #.
PANEL_COLOR=5865F2

# Reservado para um assistente de IA futuro. Com false, o bot não chama o Ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_API_KEY=
AI_ASSISTANT_ENABLED=false
